{
  "name": "pykasu-poc-2",
  "version": "0.2.0",
  "private": true,
  "description": "Chronological feed reader proof of concept built with NestJS and TypeScript",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "backup": "node dist/src/backup.js",
    "restore": "node dist/src/backup.js restore"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.2.0",
    "jsdom": "26.1.0",
    "reflect-metadata": "0.2.2",
    "robots-parser": "3.0.1",
    "rxjs": "7.8.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.6",
    "jest": "30.1.3",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "ajv": "8.20.0",
    "fastify": "5.12.7"
  }
}
