# Copy to /etc/pykasu/pykasu.env on the VM. Keep this file readable only by
# root (systemd reads it before starting the pykasu service); it contains a
# provider credential.
PYKASU_BIND=127.0.0.1
PYKASU_PORT=8000
PYKASU_DATA_DIR=/var/lib/pykasu
PYKASU_GROQ_API_KEY=replace-with-your-groq-api-key
# Turn this on only after enabling Zero Data Retention in Groq Data Controls.
PYKASU_GROQ_ZERO_DATA_RETENTION=enabled
